{
  "name": "tasks-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": "12.21.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "migrate": "node --env-file-if-exists=.env src/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "test:core": "node --test tests/database.test.ts tests/tasks.test.ts",
    "setup:env": "node scripts/setup-env.mjs",
    "security:check": "pnpm audit --audit-level=low"
  },
  "dependencies": {
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "25.7.0",
    "typescript": "5.9.3"
  }
}
